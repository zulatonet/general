# Copie para .env (local) ou cadastre no Easypanel em "Environment".

# Connection string do PostgreSQL (Supabase, Neon etc.). Obrigatória.
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (porta 6543).
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Senha para os comandos /admin. Se vazia, ninguém consegue virar admin.
ADMIN_PASSWORD=troque-esta-senha

# Opcionais
PORT=8080
ADMIN_RESET_MINUTES=60
SESSION_DAYS=30
PRIVATE_TTL_HOURS=24
TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
