# Link secreto da página da live (no chat, digite /live link e copie o endereço)
LIVE_URL=https://chat.salavip.live/live?chave=COLE_A_CHAVE_AQUI

# YouTube Studio > Transmitir ao vivo > Stream > Chave da transmissão
YOUTUBE_KEY=xxxx-xxxx-xxxx-xxxx-xxxx
# Opcional: outro servidor RTMP no lugar do YouTube. Se definido, ignora YOUTUBE_KEY.
# RTMP_URL=rtmp://a.rtmp.youtube.com/live2/xxxx-xxxx-xxxx-xxxx-xxxx

# Opcional: transmitir AO MESMO TEMPO para outros lugares (Rumble, Twitch, Kick...).
# Endereço completo com a chave; vários separados por vírgula. Cada destino soma
# o upload do vídeo, mas não gasta mais CPU. Se um cair, os outros seguem no ar.
# RTMP_EXTRA=rtmp://rtmp.rumble.com/live/CHAVE_DO_RUMBLE

# Imagem
RESOLUCAO=1280x720
FPS=30
VIDEO_KBPS=2500
AUDIO_KBPS=160
# ultrafast = menos CPU (imagem um pouco pior); veryfast = padrão
PRESET=veryfast

# Músicas de fundo (em loop, embaralhadas)
# Coloque .mp3 no volume montado em /musicas, e/ou links diretos separados por vírgula:
MUSICAS_URLS=
MUSICA_VOLUME=0.35
# aleatoria = sorteia a ordem de novo a cada volta; sequencial = em ordem de nome
MUSICAS_ORDEM=aleatoria
# 1 = a música abaixa sozinha quando toca um áudio de usuário
ABAIXAR_MUSICA=1

# Reabre o navegador a cada N horas (evita vazamento de memória). 0 = nunca
REINICIAR_NAVEGADOR_H=12
